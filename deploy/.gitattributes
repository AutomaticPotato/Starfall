# Installer entrypoints must survive Windows Git checkouts with core.autocrlf enabled.
setup.sh text eol=lf
installer.py text eol=lf
setup.ps1 text eol=crlf
installer-tests/*.py text eol=lf
# every shell script runs inside Linux/WSL: admin.sh and maintenance/*.sh too
*.sh text eol=lf
.env.example text eol=lf
